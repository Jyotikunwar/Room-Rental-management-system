generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TENANT
  LANDLORD
  ADMIN
}

enum RoomType {
  SINGLE
  DOUBLE
  FLAT
  APARTMENT
}

enum RoomStatus {
  AVAILABLE
  BOOKED
  UNDER_MAINTENANCE
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum SavedPaymentMethodType {
  ESEWA
  KHALTI
  BANK
  CASH
}

enum ComplaintStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum NotificationType {
  BOOKING
  PAYMENT
  MESSAGE
  REVIEW
  SYSTEM
}

enum IdentificationType {
  CITIZENSHIP
  PASSPORT
  NATIONAL_ID
  DRIVING_LICENSE
}

model User {
  id                Int                 @id @default(autoincrement())
  fullName          String
  email             String              @unique
  password          String
  phone             String?
  role              Role                @default(TENANT)
  avatarUrl         String?
  notificationPrefs Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  idType            IdentificationType?
  idNumber          String?
  idDocumentUrl     String?
  isIdVerified      Boolean             @default(false)

  rooms      Room[]
  bookings   Booking[]
  favorites  Favorite[]
  reviews    Review[]
  complaints Complaint[]

  sentMessages     Message[] @relation("Sender")
  receivedMessages Message[] @relation("Receiver")

  notifications      Notification[]
  recommendationLogs RecommendationLog[]
  paymentMethods     PaymentMethod[]
}

model Room {
  id Int @id @default(autoincrement())

  landlordId Int
  landlord   User @relation(fields: [landlordId], references: [id], onDelete: Cascade)

  title       String
  description String?

  city     String
  location String
  address  String?

  latitude  Float?
  longitude Float?

  roomType RoomType

  price Int

  securityDeposit Int?

  availableFrom DateTime?

  status RoomStatus @default(AVAILABLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roomImages    RoomImage[]
  roomAmenities RoomAmenity[]

  bookings           Booking[]
  favorites          Favorite[]
  reviews            Review[]
  messages           Message[]
  recommendationLogs RecommendationLog[]

  @@index([city])
  @@index([price])
  @@index([status])
}

model RoomImage {
  id Int @id @default(autoincrement())

  roomId Int
  room   Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  imageUrl String

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
}

model Amenity {
  id Int @id @default(autoincrement())

  name String @unique

  icon String?

  roomAmenities RoomAmenity[]
}

model RoomAmenity {
  roomId    Int
  amenityId Int

  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([roomId, amenityId])
}

model Booking {
  id Int @id @default(autoincrement())

  roomId Int
  room   Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  tenantId Int
  tenant   User @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  bookingDate DateTime @default(now())

  moveInDate DateTime
  endDate    DateTime?

  totalAmount Int?

  notes String?

  status BookingStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment?

  complaints Complaint[]

  @@index([status])
}

model Payment {
  id Int @id @default(autoincrement())

  bookingId Int     @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  amount Int

  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  transactionId String? @unique

  status PaymentStatus @default(PENDING)

  paidAt DateTime?

  createdAt       DateTime @default(now())
  paymentMethodId Int
}

model PaymentMethod {
  id        Int                    @id @default(autoincrement())
  userId    Int
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      SavedPaymentMethodType
  label     String
  detail    String?
  isDefault Boolean                @default(false)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  payments  Payment[]
}

model Favorite {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  roomId Int
  room   Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, roomId])
}

model Review {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  roomId Int
  room   Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  rating Int

  comment String?

  createdAt DateTime @default(now())
}

model Complaint {
  id Int @id @default(autoincrement())

  bookingId Int
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String

  description String

  status ComplaintStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Message {
  id Int @id @default(autoincrement())

  senderId Int
  sender   User @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId Int
  receiver   User @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  roomId Int?
  room   Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  message       String
  attachmentUrl String?
  isRead        Boolean @default(false)

  createdAt DateTime @default(now())
}

model Notification {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String

  message String

  type NotificationType

  isRead Boolean @default(false)

  createdAt DateTime @default(now())
}

model RecommendationLog {
  id              Int      @id @default(autoincrement())
  tenantId        Int?
  roomId          Int
  similarityScore Float
  popularityScore Float
  finalScore      Float
  createdAt       DateTime @default(now())

  tenant User? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  room   Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([roomId])
}
